#!/bin/bash
#
# Live-ISO entry point for the Omarchy Artix+dinit installer. Invoked from
# /root/.automated_script.sh after the configurator wizard has produced its
# user_*.json / user_*.txt files. The outer shim owns install logging.

set -eEo pipefail

exec /usr/share/omarchy-iso/artix-install.sh "$@"
