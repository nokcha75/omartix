#!/bin/bash

# omarchy:summary=Install and configure Voxtype dictation
# omarchy:requires-sudo=true

set -e

# Install voxtype and configure it for use.

if gum confirm "Install Voxtype + AI model (~150MB) to enable dictation?"; then
  omarchy-pkg-add wtype voxtype-bin

  # Setup voxtype
  mkdir -p ~/.config/voxtype
  cp "$OMARCHY_PATH/default/voxtype/config.toml" ~/.config/voxtype/

  voxtype setup --download --no-post-install
  if omarchy-hw-vulkan; then
    voxtype setup gpu --enable || true
  fi
  # Install the packaged dinit user service. It is started from Hyprland's
  # autostart so Wayland/PipeWire environment variables are already present.
  install -d "$HOME/.config/dinit.d"
  install -Dm644 /usr/share/voxtype/voxtype.dinit "$HOME/.config/dinit.d/voxtype"
  hypr_autostart="$HOME/.config/hypr/autostart.lua"
  mkdir -p "$(dirname "$hypr_autostart")"
  touch "$hypr_autostart"
  if ! grep -Fxq 'o.launch_on_start("dinitctl --user start voxtype")' "$hypr_autostart"; then
    printf '\no.launch_on_start("dinitctl --user start voxtype")\n' >>"$hypr_autostart"
  fi
  dinitctl --user start voxtype

  hyprctl reload >/dev/null
  omarchy-restart-shell
  omarchy-notification-send -g  "Voxtype Dictation Ready" "Hold F9 to dictate (or toggle with Super + Ctrl + X)." -t 10000
fi
