#!/bin/bash
# Release Plymouth's DRM hold before SDDM/Hyprland start. Always exit 0 so a
# missing splash cannot block the display manager.
command -v plymouth >/dev/null || exit 0

for _ in $(seq 1 50); do
  if plymouth --ping >/dev/null 2>&1; then
    plymouth quit >/dev/null 2>&1 || true
    exit 0
  fi
  sleep 0.1
done

exit 0
