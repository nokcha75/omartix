#!/bin/bash

# omarchy:hidden=true
# omarchy:summary=Expire a temporary passwordless sudo grant

set -euo pipefail

uid=${1:-}
[[ $uid =~ ^[0-9]+$ ]] || exit 2
state_file="/var/lib/omarchy/nopasswd-sudo/$uid"
[[ -f $state_file ]] || exit 0
deadline=$(<"$state_file")
[[ $deadline =~ ^[0-9]+$ ]] || exit 2
remaining=$((deadline - $(date +%s)))
((remaining > 0)) && sleep "$remaining"
user=$(getent passwd "$uid" | cut -d: -f1)
[[ -n $user ]] || exit 2
rm -f "$state_file" "/etc/sudoers.d/99-omarchy-nopasswd-$user" \
  "/etc/dinit.d/boot.d/omarchy-nopasswd-expire-$uid" \
  "/etc/dinit.d/omarchy-nopasswd-expire-$uid"
