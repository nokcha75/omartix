#!/bin/bash

# omarchy:summary=Manage the OpenClaw Gateway with Omartix's dinit user manager
# omarchy:args=[install|start|stop|status|remove]

set -euo pipefail

service_name=openclaw-gateway
config_home=${XDG_CONFIG_HOME:-$HOME/.config}
service_dir="$config_home/dinit.d"
boot_dir="$service_dir/boot.d"
service_file="$service_dir/$service_name"
boot_link="$boot_dir/$service_name"

require_user_manager() {
  if ! dinitctl --user list >/dev/null 2>&1; then
    echo "OpenClaw requires the Omartix dinit user manager." >&2
    exit 1
  fi
}

install_service() {
  require_user_manager
  install -d -m 0755 "$service_dir" "$boot_dir"
  cat >"$service_file" <<'DINIT'
# Omartix owns Gateway supervision. Do not use `openclaw gateway install`:
# upstream writes a systemd user unit on Linux.
type = process
command = /usr/bin/openclaw gateway
restart = true
restart-delay = 5
DINIT
  ln -sfn "../$service_name" "$boot_link"
}

case "${1:-status}" in
install)
  install_service
  ;;
start)
  install_service
  dinitctl --user start "$service_name"
  ;;
stop)
  require_user_manager
  dinitctl --user stop "$service_name"
  ;;
status)
  require_user_manager
  dinitctl --user status "$service_name"
  ;;
remove)
  require_user_manager
  dinitctl --user stop "$service_name" >/dev/null 2>&1 || true
  rm -f "$boot_link" "$service_file"
  ;;
*)
  echo "Usage: omarchy-openclaw-gateway [install|start|stop|status|remove]" >&2
  exit 1
  ;;
esac
