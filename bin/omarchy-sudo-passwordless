#!/bin/bash

# omarchy:summary=Temporarily enable passwordless sudo with dinit expiry
# omarchy:args=[MINUTES]
# omarchy:requires-sudo=true

set -euo pipefail

minutes=${1:-15}
if [[ ! $minutes =~ ^[0-9]+$ ]] || ((minutes == 0)); then
  echo "Usage: omarchy-sudo-passwordless [MINUTES]" >&2
  exit 1
fi

user=$(id -un)
uid=$(id -u)
state_dir=/var/lib/omarchy/nopasswd-sudo
state_file="$state_dir/$uid"
sudoers_file="/etc/sudoers.d/99-omarchy-nopasswd-$user"
service="omarchy-nopasswd-expire-$uid"
service_file="/etc/dinit.d/$service"
boot_link="/etc/dinit.d/boot.d/$service"

remove_grant() {
  sudo dinitctl stop "$service" 2>/dev/null || true
  sudo rm -f "$boot_link" "$service_file" "$state_file" "$sudoers_file"
}

if sudo test -f "$sudoers_file"; then
  remove_grant
  if [[ -z ${1:-} ]]; then
    echo "Passwordless sudo has been DISABLED. Sudo will require a password again."
    exit 0
  fi
fi

echo "WARNING: this grants any process running as your user full root access"
echo "without a password for $minutes minutes."
if ! gum confirm "Enable passwordless sudo for $minutes minutes? This is a significant security risk!"; then
  echo "Aborted. No changes made."
  exit 0
fi

deadline=$(( $(date +%s) + minutes * 60 ))
sudo install -d -m700 "$state_dir" /etc/dinit.d/boot.d
printf '%s\n' "$deadline" | sudo tee "$state_file" >/dev/null
sudo chmod 600 "$state_file"
sudo chown root:root "$state_file"
printf '%s ALL=(ALL:ALL) NOPASSWD: ALL\n' "$user" | sudo tee "$sudoers_file" >/dev/null
sudo chmod 440 "$sudoers_file"
if ! sudo visudo -cf "$sudoers_file" >/dev/null; then
  remove_grant
  echo "Failed to validate the temporary sudoers rule." >&2
  exit 1
fi

sudo install -Dm644 /dev/stdin "$service_file" <<DINIT
type = process
command = /usr/bin/omarchy-sudo-passwordless-expire $uid
restart = false
DINIT
sudo ln -sfn "../$service" "$boot_link"
if ! sudo dinitctl start "$service"; then
  remove_grant
  echo "Failed to start the dinit expiry service; access was revoked." >&2
  exit 1
fi

echo "Passwordless sudo has been ENABLED. It will automatically disable in $minutes minutes."
