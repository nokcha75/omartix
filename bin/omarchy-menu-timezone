#!/bin/bash

# omarchy:summary=Select and set the system timezone
# omarchy:group=menu
# omarchy:name=timezone

set -e

timezone=$(awk '$1 !~ /^#/ && NF >= 3 {print $3}' /usr/share/zoneinfo/zone.tab | \
  omarchy-menu-select "Set timezone" -- --width 520 --maxheight 520) || exit 1
[[ -e "/usr/share/zoneinfo/$timezone" ]] || exit 1
sudo ln -sfn "/usr/share/zoneinfo/$timezone" /etc/localtime
printf '%s\n' "$timezone" | sudo tee /etc/timezone >/dev/null
omarchy-shell -q omarchy.clock refresh
omarchy-notification-send "Timezone is now set to $timezone"
